# 复制本文件为 .env 后填入真实值。.env 已被 .gitignore，不会进仓库。
# ────────────────────────────────────────────────────────────

# 飞书自建应用凭证（开发者后台 → 凭证与基础信息）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=填这里_别提交

# 目标群 chat_id（形如 oc_xxxx）。
# 拿不到先把机器人拉进群，再跑：npm run list-chats
FEISHU_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxx

# 群晖 data 文件夹路径（就是工具里选的那个，含 records.json）
# Windows 例：Z:\图测记录工具\data
# Mac/Linux 例：/Volumes/figtest/data 或 /mnt/figtest/data
DATA_DIR=Z:\图测记录工具\data

# 飞书域名：中国版用 open.feishu.cn（默认），国际 Lark 用 open.larksuite.com
FEISHU_DOMAIN=https://open.feishu.cn
